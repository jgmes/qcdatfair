---
import '../styles/global.css';
const { title = 'QCD at FAIR', description = 'Exploring strong QCD with hadron beams at GSI and FAIR.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['Science', import.meta.env.BASE_URL + 'science/'], ['Facilities', import.meta.env.BASE_URL + 'facilities/'],
  ['Community', import.meta.env.BASE_URL + 'community/'], ['Contribute', import.meta.env.BASE_URL + 'contribute/'], ['Resources', import.meta.env.BASE_URL + 'resources/'], ['Contact', import.meta.env.BASE_URL + 'contact/']
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href={Astro.site + import.meta.env.BASE_URL} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#081b2b" />
    <title>{title} · QCD at FAIR</title>
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} />
  </head>
  <body>
    <section class="access-gate" id="access-gate" aria-labelledby="gate-title">
      <div class="gate-grid"></div>
      <div class="gate-panel">
        <img class="gate-logo" src={import.meta.env.BASE_URL + "images/qcdatfair-logo.png"} alt="QCD at FAIR" />
        <div class="gate-kicker"><span></span> COMMUNITY ACCESS</div>
        <h1 id="gate-title">The strong interaction.<br /><em>A shared frontier.</em></h1>
        <p class="gate-intro">Welcome to QCD at FAIR — connecting the hadron-physics community around the scientific opportunities at GSI and FAIR.</p>
        <form id="access-form" class="gate-form">
          <label for="access-password">Enter access password</label>
          <div class="gate-input-row">
            <input id="access-password" name="password" type="password" placeholder="Password" autocomplete="current-password" required />
            <button type="submit">Enter <span>↗</span></button>
          </div>
          <p class="gate-error" id="gate-error" role="alert" aria-live="polite"></p>
        </form>
        <div class="gate-foot">HADRON PHYSICS · QCD · GSI / FAIR</div>
      </div>
    </section>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL + ""} aria-label="QCD at FAIR home">
        <svg class="qcd-animated-logo" viewBox="0 0 1106 408" role="img" aria-label="QCD at FAIR" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="qcd-flux-gradient" x1="0" x2="1"><stop offset="0" stop-color="#00ed20"/><stop offset=".5" stop-color="#ff1010"/><stop offset="1" stop-color="#1010ff"/></linearGradient>
            <filter id="qcd-soft-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <path class="qcd-flux" d="M165 225 C205 160 235 290 270 220 S330 160 365 225" fill="none" stroke="url(#qcd-flux-gradient)" stroke-width="5" stroke-linecap="round"/>
          <g class="qcd-letter-q"><image href={import.meta.env.BASE_URL + "images/logo-q.png"} x="20" y="115" width="215" height="215" /></g>
          <g class="qcd-letter-d"><image href={import.meta.env.BASE_URL + "images/logo-d.png"} x="290" y="115" width="180" height="210" /></g>
          <g class="qcd-letter-c"><image href={import.meta.env.BASE_URL + "images/logo-c.png"} x="190" y="115" width="120" height="215" /><path class="qcd-gluon-loop" d="M228 195 C244 170 270 181 265 207 C260 231 231 233 224 213 C221 206 223 200 228 195Z" fill="none" stroke="#ff3030" stroke-width="4" stroke-linecap="round"/></g>
          <image href={import.meta.env.BASE_URL + "images/logo-at-fair.png"} x="475" y="0" width="631" height="408" />
        </svg>
      </a>
      <button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">☰</button>
      <nav class="main-nav" aria-label="Main navigation">
        {nav.map(([label, href]) => <a class:list={{ active: path === href }} href={href}>{label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-top">
        <a class="brand footer-brand" href={import.meta.env.BASE_URL + ""} aria-label="QCD at FAIR home"><svg class="qcd-animated-logo" viewBox="0 0 1106 408" role="img" aria-label="QCD at FAIR" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="qcd-flux-gradient" x1="0" x2="1"><stop offset="0" stop-color="#00ed20"/><stop offset=".5" stop-color="#ff1010"/><stop offset="1" stop-color="#1010ff"/></linearGradient>
            <filter id="qcd-soft-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <path class="qcd-flux" d="M165 225 C205 160 235 290 270 220 S330 160 365 225" fill="none" stroke="url(#qcd-flux-gradient)" stroke-width="5" stroke-linecap="round"/>
          <g class="qcd-letter-q"><image href={import.meta.env.BASE_URL + "images/logo-q.png"} x="20" y="115" width="215" height="215" /></g>
          <g class="qcd-letter-d"><image href={import.meta.env.BASE_URL + "images/logo-d.png"} x="290" y="115" width="180" height="210" /></g>
          <g class="qcd-letter-c"><image href={import.meta.env.BASE_URL + "images/logo-c.png"} x="190" y="115" width="120" height="215" /><path class="qcd-gluon-loop" d="M228 195 C244 170 270 181 265 207 C260 231 231 233 224 213 C221 206 223 200 228 195Z" fill="none" stroke="#ff3030" stroke-width="4" stroke-linecap="round"/></g>
          <image href={import.meta.env.BASE_URL + "images/logo-at-fair.png"} x="475" y="0" width="631" height="408" />
        </svg></a>
        <p>A coordinated community exploring the strong interaction<br />with hadron beams at GSI and FAIR.</p>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} QCD at FAIR initiative</span><span>Research · Collaboration · Discovery</span></div>
    </footer>
    <script is:inline>
      (() => {
        const initialiseQcdatfair = () => {
          const gate = document.getElementById('access-gate');
          const accessForm = document.getElementById('access-form');
          const accessInput = document.getElementById('access-password');
          const gateError = document.getElementById('gate-error');
          const accessKey = 'qcdatfair-access-granted-v3';

          // Storage is a convenience only. It must never prevent password entry.
          try {
            if (window.localStorage && localStorage.getItem(accessKey) === 'yes') {
              gate?.classList.add('is-hidden');
            }
          } catch (_storageError) {
            // Continue with a fresh password check when storage is unavailable.
          }

          if (accessForm && !accessForm.dataset.gateReady) {
            accessForm.dataset.gateReady = 'true';
            accessForm.addEventListener('submit', (event) => {
              event.preventDefault();
              const entered = accessInput ? accessInput.value.trim() : '';
              if (entered === 'HadronsAtGSI') {
                try { localStorage.setItem(accessKey, 'yes'); } catch (_storageError) { /* optional */ }
                gate?.classList.add('is-hidden');
                if (gateError) gateError.textContent = '';
              } else {
                if (gateError) gateError.textContent = 'That password was not recognised. Please try again.';
                if (accessInput) { accessInput.value = ''; accessInput.focus(); }
              }
            });
          }

          const toggle = document.querySelector('.menu-toggle');
          const nav = document.querySelector('.main-nav');
          if (toggle && nav && !toggle.dataset.menuReady) {
            toggle.dataset.menuReady = 'true';
            toggle.addEventListener('click', () => {
              const open = nav.classList.toggle('open');
              toggle.setAttribute('aria-expanded', String(open));
            });
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initialiseQcdatfair, { once: true });
        } else {
          initialiseQcdatfair();
        }
      })();
    </script>
  </body>
</html>
